# DARWIN — environment
#
# Copy to `.env` and fill in. `.env` is gitignored; this file must never contain a
# real key. The cadence key signs a transaction every fifteen minutes for eleven days,
# so it is a hot key by construction: fund it from the faucet, give it nothing else,
# and treat its address as public.

# ─── Required ────────────────────────────────────────────────────────────────────

# Deployer + cadence driver. Population.think()/commitAll() are owner-gated, so unless
# you set OWNER separately this key IS the population's driver.
PRIVATE_KEY=0x

# The Somnia Agents model id. NOT optional and NOT guessable — fetch it from
# agents.somnia.network. Deploy.s.sol refuses to run with 0, because a population that
# cannot think abstains every window, pays metabolism anyway, and dies of nothing.
LLM_AGENT_ID=

# ─── Network (Shannon testnet, chain 50312) ──────────────────────────────────────

SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_CHAIN_ID=50312
SOMNIA_EXPLORER=https://shannon-explorer.somnia.network
SOMNIA_EXPLORER_KEY=

# DreamDEX off-chain surfaces. Used by the cadence to read the window's opening price
# and by the frontend for the live book.
DREAMDEX_REST=https://stg.api.dreamdex.io/v0
DREAMDEX_WS=wss://stg.api.dreamdex.io/v0/ws/public

# ─── Optional: roles ─────────────────────────────────────────────────────────────

# Defaults to the deployer. WARNING: this is the population's driver as well as its
# admin. A cold OWNER silently stops the cadence.
# OWNER=0x
# Pushes prices to PushedPriceSource. Defaults to the deployer.
# UPDATER=0x
# Owns SelectionEngine.poke(). Defaults to UPDATER, because poke() is a cadence call
# standing in for the reactivity precompile, not an administrative one.
# ENGINE_OWNER=0x

# ─── Optional: address overrides (verified Shannon defaults are in Deploy.s.sol) ──

# AGENT_REQUESTER=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776
# BINARY_MARKETS_MODULE=0x3ecC694Cef705358864a646142ac17A90E29e388
# BINARY_SETTLEMENT=0xbF4a49e0Dfd092e5FBE8E5761064C49533e6Ed23
# OUTCOME_TOKEN=0xB52c5934113Af5c0Bb20eb3C72290C8215f755b9
# COLLATERAL=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E
# MARKET_SYMBOL=BTC

# ─── Optional: deploy guards (all default to off — leave them off) ───────────────

# ALLOW_ANY_CHAIN=false          # deploy off chain 50312
# ALLOW_PLACEHOLDER_AGENT=false  # deploy with LLM_AGENT_ID=0, i.e. unable to think
# ALLOW_ANY_DECIMALS=false       # deploy against non-6dp collateral (mainnet is 18dp)
# ALLOW_RESEED=false             # let Seed.s.sol append a SECOND generation 0

# ─── Optional: cadence ───────────────────────────────────────────────────────────

# Which market the population trades is fixed at deploy time (MARKET_SYMBOL above) and
# recorded in the manifest, not chosen per run. What is tunable is the timing.

# Seconds before expiry to stop opening new positions.
# CADENCE_COMMIT_LEAD=60
# Refuse to START a window with less than this much time left. Inference is asynchronous
# with a 300s timeout, and a commitment that lands after expiry is a window where every
# organism paid to think and then had nothing to think about.
# CADENCE_MIN_WINDOW=360
# How long to wait for validator responses before committing on whatever arrived.
# CADENCE_INFERENCE_PATIENCE=330
# How long to wait for the precompile to settle before reaching for poke().
# CADENCE_REACTIVITY_PATIENCE=90
# CADENCE_POLL=5
# CADENCE_IDLE=15
# Set once reactivity is confirmed: stops the cadence calling SelectionEngine.poke().
# CADENCE_USE_REACTIVITY=false

# ─── Optional: reactivity subscription (npm run subscribe) ───────────────────────

# The external entrypoint the 0x0100 precompile invokes on the handler.
#
# LEAVE THIS UNSET. It is now VERIFIED against `SomniaEventHandlerABI` in
# @somnia-chain/reactivity@0.2.1 and hardcoded as the default, and `Darwin.t.sol` pins the
# signature so a drift breaks the test suite. It survives as an escape hatch against a
# future SDK change only — setting it wrongly is the one remaining way to build a
# subscription that is created successfully and can never fire.
# REACTIVITY_CALLBACK_SIG=onEvent(address,bytes32[],bytes)

# Gas ceiling for each reactive callback. 10,000,000 is the SDK's own default and the
# precompile's ceiling is 200,000,000, so at eight organisms this is nowhere near
# gas-bound. A callback that runs out of gas emits NOTHING — not even the ReactionFailed
# the catch block would log — which is indistinguishable from a subscription that never
# fired. `npm run subscribe -- --discover` prints the measured floor from a real receipt.
# REACTIVITY_GAS_LIMIT=10000000

# THERE IS NO GAS PAYER, NO REFUNDEE, AND NO INCLUDE-DATA FLAG.
#
# Earlier revisions of this file documented REACTIVITY_GAS_PAYER, REACTIVITY_REFUNDEE and
# REACTIVITY_INCLUDE_DATA. None of those fields exist on the precompile — the real
# `SubscriptionData` struct has no such members, and nothing ever read the variables. They
# are listed here, once, so that anyone who finds them in an old .env knows to delete them
# rather than wonder why they have no effect.
#
# The subscription's OWNER — the account that sent the subscribe transaction, i.e. whoever
# holds PRIVATE_KEY — funds every callback out of its own balance, and the SDK refuses to
# create a subscription while that balance is under 32 SOMI. If it empties later, reactivity
# stops with no error, no event and no log; `npm run subscribe -- --status` exists to catch
# exactly that, and reports the balance every time.
#
# Two subscription flags are set on the command line rather than here, because they are
# per-run decisions:
#   --no-coalesced   one callback per matching log instead of one per block. Coalescing is
#                    ON by default and is safe because the handler ignores the payload.
#   --pool <addr>    narrow to one pool via topic2. HAZARDOUS: pools are recycled across
#                    windows, so this can go stale and stop matching silently.

# ─── Optional: monitor thresholds ────────────────────────────────────────────────

# MONITOR_INTERVAL=60        # seconds between checks
# MONITOR_PHASE_STALL=1200   # longer than one 15m window, so normal cadence is not a stall
# MONITOR_WINDOW_STALL=2400
# MONITOR_MIN_RUNWAY=96      # windows of inference left before it complains (~1 day)

# ─── Optional: price source ──────────────────────────────────────────────────────

# `rest` reads the window's opening price from DreamDEX. `manual` pins the window from the
# four variables below instead, and exists because the REST response shape is UNVERIFIED
# and neither the go-live nor the demo may be blocked on it.
# PRICE_MODE=rest
#
# PRICE_MODE=manual requires all three of these. Prices are INTEGERS already scaled by
# PRICE_DECIMALS — no float ever touches a value the organisms are graded against.
# MARKET_ID=0x                 # 32-byte hex, from BinaryMarketsModule
# OPEN_PRICE=110432500000      # e.g. $110,432.50 at 6 decimals
# LAST_PRICE=110498200000
# PRICE_DECIMALS=6
