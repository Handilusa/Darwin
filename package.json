{
  "name": "darwin",
  "version": "0.1.0",
  "private": true,
  "description": "An on-chain population of AI forecasters that must survive real market settlement to keep existing.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cadence": "tsx scripts/cadence.ts",
    "cadence:once": "tsx scripts/cadence.ts --once",
    "cadence:selftest": "tsx scripts/cadence.ts --self-test",
    "fund": "tsx scripts/fund.ts",
    "monitor": "tsx scripts/monitor.ts",
    "monitor:selftest": "tsx scripts/monitor.ts --self-test",
    "subscribe": "tsx scripts/subscribe.ts",
    "fee": "tsx scripts/measure-fee.ts",
    "prove": "tsx scripts/prove-same-block.ts",
    "typecheck": "tsc --noEmit",
    "fmt:check": "forge fmt --check --root contracts",
    "abi:check": "tsx scripts/abi-drift.ts",
    "cite:check": "tsx scripts/cite-drift.ts",
    "cite:selftest": "tsx scripts/cite-drift.ts --self-test",
    "count:check": "tsx scripts/count-drift.ts",
    "count:selftest": "tsx scripts/count-drift.ts --self-test",
    "scan:selftest": "tsx scripts/lib/logscan.ts",
    "build": "forge build --root contracts",
    "test": "forge test --root contracts -vv",
    "gate": "npm run typecheck && npm run fmt:check && npm run cite:selftest && npm run cite:check && npm run count:selftest && npm run count:check && npm run cadence:selftest && npm run monitor:selftest && npm run scan:selftest && npm run test && npm run abi:check && npm --prefix web test && npm --prefix app test",
    "hardhat": "hardhat"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "hardhat": "^2.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "@somnia-chain/markets-sdk": "0.28.1",
    "@somnia-chain/reactivity": "0.2.1"
  }
}
