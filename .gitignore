# Deployment artifacts
contracts/broadcast/
!contracts/broadcast/**/dry-run/

# Deploy manifests are intentionally committed.
# They contain public contract addresses/config, not secrets.
#
# NEVER commit private keys or secret deployment material.
contracts/deployments/*.key
contracts/deployments/*.secret
contracts/deployments/*.pem
contracts/deployments/*private*
contracts/deployments/*secret*
contracts/deployments/*seed*
contracts/deployments/*mnemonic*
contracts/deployments/keystore/
contracts/deployments/**/keystore/


